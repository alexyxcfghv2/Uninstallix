<UserControl x:Class="Desinstalleur.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : logo, nom, statistiques -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                <TextBlock Text="Logiciels installés" Style="{StaticResource TitleText}" />
                <TextBlock Text="Désinstallez vos logiciels proprement, sans laisser de traces."
                           Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatChip}">
                    <StackPanel>
                        <TextBlock x:Name="CountText" Text="—" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="logiciels" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatChip}">
                    <StackPanel>
                        <TextBlock x:Name="TotalSizeText" Text="—" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="occupés" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatChip}">
                    <StackPanel>
                        <TextBlock x:Name="ProtectedCountText" Text="—" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="protégés" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Barre d'outils -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Tag="Rechercher un logiciel ou un éditeur…" TextChanged="SearchBox_TextChanged" />

            <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Trier" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,10,0" />
                    <Rectangle Width="1" Height="20" Fill="#33416B" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <RadioButton GroupName="Sort" Style="{StaticResource SegmentButton}" Content="Nom" Tag="0"
                                 IsChecked="True" Checked="Sort_Checked" />
                    <RadioButton GroupName="Sort" Style="{StaticResource SegmentButton}" Content="Taille" Tag="1" Checked="Sort_Checked" />
                    <RadioButton GroupName="Sort" Style="{StaticResource SegmentButton}" Content="Date" Tag="2" Checked="Sort_Checked" />
                    <RadioButton GroupName="Sort" Style="{StaticResource SegmentButton}" Content="Éditeur" Tag="3" Checked="Sort_Checked" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Margin="12,0,0,0" Padding="14,9" Click="Refresh_Click" ToolTip="Actualiser la liste">
                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="15" />
            </Button>
        </Grid>

        <!-- Liste des logiciels -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Options d'affichage -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,14,18,4">
                    <CheckBox x:Name="ShowSystemBox" Style="{StaticResource ToggleSwitch}" Content="Afficher les composants système"
                              ToolTip="Afficher aussi les composants que Windows masque habituellement"
                              Checked="ShowSystemBox_Changed" Unchecked="ShowSystemBox_Changed" />
                    <CheckBox x:Name="UnlockProtectedBox" Style="{StaticResource ToggleSwitch}" Margin="28,0,0,0"
                              Content="Déverrouiller les éléments protégés"
                              ToolTip="Autoriser la sélection des composants essentiels (pilotes, runtimes…)"
                              Checked="UnlockProtectedBox_Checked" Unchecked="UnlockProtectedBox_Unchecked" />
                </StackPanel>

                <DataGrid x:Name="ProgramsGrid" Grid.Row="1" Margin="4,0,4,6" MouseDoubleClick="ProgramsGrid_MouseDoubleClick"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2" VirtualizingPanel.CacheLengthUnit="Page">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="ProgramMenu_Opened">
                            <MenuItem Header="Désinstaller ce logiciel" Click="UninstallOne_Click" />
                            <MenuItem x:Name="FavoriteMenuItem" Header="Ajouter aux favoris protégés" Click="ToggleFavorite_Click" />
                            <MenuItem Header="Ouvrir le dossier d'installation" Click="OpenFolder_Click" />
                            <MenuItem Header="Copier le nom" Click="CopyName_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="LOGICIEL" Width="*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0"
                                                Background="{StaticResource CardBackgroundRaised}" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15"
                                                           Foreground="#5AB4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TAILLE" Width="120" SortMemberPath="SortSize">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="INSTALLÉ LE" Width="140" SortMemberPath="SortDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstallDateText}" Foreground="{StaticResource TextSecondary}"
                                               ToolTip="« ≈ » : date estimée, le logiciel ne l'indique pas" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="130" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}"
                                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{Binding ProtectionReason}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="12"
                                                       Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="Protégé" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Aucun logiciel ne correspond à votre recherche."
                           Style="{StaticResource SecondaryText}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                    <TextBlock Text="Analyse des logiciels installés…" Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre d'action -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource Card}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE73A;" Style="{StaticResource IconText}" FontSize="15" Foreground="#5AB4FF"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextPrimary}" Text="Aucun logiciel sélectionné" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Tout désélectionner" Click="ClearSelection_Click" />
                <Button x:Name="UninstallButton" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                        IsEnabled="False" Click="UninstallSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Désinstaller la sélection" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
