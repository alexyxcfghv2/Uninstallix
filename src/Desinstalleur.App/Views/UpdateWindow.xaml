<Window x:Class="Desinstalleur.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstallix · Mise à jour"
        Icon="/Assets/uninstallix.ico"
        Width="620" Height="540" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,18">
            <Border x:Name="Badge" Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoft}">
                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="22" Foreground="#5AB4FF" HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="TitleText" Text="Nouvelle version disponible" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" Margin="1,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="NOUVEAUTÉS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="21" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadBar" Maximum="100" Height="6" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OpenPage_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Voir sur GitHub" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="Plus tard" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Later_Click"
                        IsCancel="True" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Click="Install_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Installer la mise à jour" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
