<Window x:Class="Desinstalleur.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Desinstalleur.App.Services"
        Title="Uninstallix · Aperçu du nettoyage"
        Icon="/Assets/uninstallix.ico"
        Width="900" Height="680" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Aperçu avant nettoyage" Style="{StaticResource TitleText}" FontSize="24" />
                <TextBlock x:Name="SubtitleText" Text="Analyse de ce qui sera supprimé…" Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="TotalText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="à libérer" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Logiciels à fermer -->
        <Border x:Name="RunningCard" Grid.Row="1" Background="{StaticResource WarningSoft}" CornerRadius="12" Padding="16,12"
                Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Applications à fermer" FontWeight="SemiBold" />
                    <TextBlock x:Name="RunningText" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="CloseAppsButton" Grid.Column="2" Margin="14,0,0,0" Click="CloseApps_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Fermer ces applications" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Liste -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock Text="Analyse des fichiers…" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="10,8,10,10" services:Anim.EnterOnLoad="True">
                                <StackPanel>
                                    <Grid Margin="8,4,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource CardBackgroundRaised}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15" Foreground="#5AB4FF"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                                            <!-- Conséquence du nettoyage de ce cache -->
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ConsequenceIcon" Text="&#xE946;" Style="{StaticResource IconText}" FontSize="12"
                                                           Foreground="#5AB4FF" VerticalAlignment="Top" Margin="0,2,7,0" />
                                                <TextBlock x:Name="ConsequenceText" Grid.Column="1" Text="{Binding Target.DisplayConsequence}" FontSize="12"
                                                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ShownEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,6" Margin="0,1"
                                                        ToolTip="{Binding Path}" Cursor="Hand" MouseLeftButtonUp="Entry_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="13"
                                                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Target.Impact}" Value="Notice">
                                    <Setter TargetName="ConsequenceIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="ConsequenceIcon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Target.Impact}" Value="Permanent">
                                    <Setter TargetName="ConsequenceIcon" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="ConsequenceIcon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter TargetName="ConsequenceText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Boutons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Cliquez sur un élément pour ouvrir son emplacement." Style="{StaticResource SecondaryText}" FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="CleanButton" Style="{StaticResource AccentButton}" Click="Clean_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA99;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nettoyer maintenant" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
