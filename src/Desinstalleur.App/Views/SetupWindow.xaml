<Window x:Class="Desinstalleur.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation d'Uninstallix"
        Icon="/Assets/uninstallix.ico"
        Width="640" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Halo bleu -->
        <Ellipse Width="700" Height="380" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-250,0,0"
                 IsHitTestVisible="False" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1E6BFF" Offset="0" />
                    <GradientStop Color="#001E6BFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="36,30,36,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel x:Name="Header" Orientation="Horizontal">
                <Image Source="/Assets/logo-mark.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TitleLabel" Text="Installer Uninstallix" FontFamily="{StaticResource DisplayFont}"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionLabel" Text="Version" Style="{StaticResource SecondaryText}" Margin="1,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Étape 1 : options -->
            <StackPanel x:Name="OptionsStep" Grid.Row="1" Margin="0,28,0,0">
                <TextBlock Text="Où voulez-vous installer Uninstallix ?" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateNote" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"
                           Text="Uninstallix est déjà installé : il sera mis à jour. Vos réglages sont conservés." />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource PathBox}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Parcourir…" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,22,0,0">
                    <StackPanel>
                        <CheckBox x:Name="DesktopBox" Content="Créer un raccourci sur le Bureau" IsChecked="True" />
                        <CheckBox x:Name="StartMenuBox" Content="Ajouter au menu Démarrer" IsChecked="True" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="2,14,0,0"
                           Text="Uninstallix apparaîtra aussi dans « Applications installées » de Windows, d'où vous pourrez le désinstaller." />
            </StackPanel>

            <!-- Étape 2 : installation en cours -->
            <StackPanel x:Name="ProgressStep" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Installation en cours…" FontSize="15" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,10" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Étape 3 : terminé -->
            <StackPanel x:Name="DoneStep" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <Border x:Name="DoneCheck" Width="56" Height="56" CornerRadius="28" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="24"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Uninstallix est installé !" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock x:Name="DoneText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <CheckBox x:Name="LaunchBox" Content="Lancer Uninstallix maintenant" IsChecked="True" Margin="0,20,0,0" />
            </StackPanel>

            <!-- Boutons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Click="Install_Click" MinWidth="130">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock x:Name="InstallButtonText" Text="Installer" />
                    </StackPanel>
                </Button>
                <Button x:Name="FinishButton" Content="Terminer" Style="{StaticResource AccentButton}" MinWidth="130"
                        Visibility="Collapsed" Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
