<UserControl x:Class="Desinstalleur.App.Views.OrphansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Restes oubliés" Style="{StaticResource TitleText}" />
                <TextBlock Text="Dossiers laissés par des logiciels déjà désinstallés." Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="CountText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountLabel" Text="dossiers trouvés" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="TotalText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="au total" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Analyse -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="Scan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Analyser" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Annuler" Margin="8,0,0,0" Click="Cancel_Click"
                        Visibility="Collapsed" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Text="Program Files, ProgramData et AppData sont examinés. Rien n'est supprimé sans votre accord." />
                    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="2" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
                <CheckBox x:Name="ShowSmallBox" Grid.Column="3" VerticalAlignment="Center" Content="Afficher les dossiers de moins de 1 Mo"
                          Checked="ShowSmall_Changed" Unchecked="ShowSmall_Changed" />
            </Grid>
        </Border>

        <!-- Avertissement -->
        <Border x:Name="InfoBanner" Grid.Row="2" Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="#5AB4FF" Margin="0,0,12,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimary}"
                           Text="Rien n'est coché d'office : ouvrez l'emplacement de chaque dossier et cochez seulement ceux dont vous êtes sûr. Les dossiers modifiés ces 30 derniers jours, ceux d'un logiciel installé ou en cours d'exécution et vos favoris protégés ne sont jamais proposés." />
            </Grid>
        </Border>

        <!-- Résultats -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <ItemsControl x:Name="OrphansList" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="10,9" Margin="0,1"
                                        services:Anim.EnterOnLoad="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="Box" VerticalAlignment="Center" Margin="2,0,12,0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0"
                                                Background="{StaticResource CardBackgroundRaised}">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="15"
                                                       Foreground="#5AB4FF" HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                           Margin="10,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,1,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock x:Name="Result" Text="{Binding ResultText}" FontSize="12" Margin="10,0,0,0"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" Margin="0,0,14,0" />

                                        <Border x:Name="Pill" Grid.Column="4" Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}"
                                                MinWidth="84" VerticalAlignment="Center">
                                            <TextBlock x:Name="PillText" Text="{Binding ConfidenceText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        </Border>

                                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" Padding="8,6" Margin="8,0,0,0"
                                                VerticalAlignment="Center" ToolTip="Ouvrir l'emplacement" Click="OpenLocation_Click">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Confidence}" Value="Likely">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="#5AB4FF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Confidence}" Value="Check">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter TargetName="Box" Property="IsEnabled" Value="False" />
                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="20"
                           Text="Cliquez sur « Analyser » pour chercher les dossiers laissés par des logiciels déjà désinstallés." />
            </Grid>
        </Border>

        <!-- Barre d'action -->
        <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" Text="Aucun dossier coché." />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectSafeButton" Content="Cocher les « Sûr »" Style="{StaticResource GhostButton}"
                            Click="SelectSafe_Click" IsEnabled="False" />
                    <Button x:Name="SelectNoneButton" Content="Tout décocher" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                            Click="SelectNone_Click" IsEnabled="False" />
                    <Button x:Name="CleanButton" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="Clean_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Nettoyer la sélection" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
