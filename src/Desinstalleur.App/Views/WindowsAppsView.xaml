<UserControl x:Class="Desinstalleur.App.Views.WindowsAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Applis Windows" Style="{StaticResource TitleText}" />
                <TextBlock Text="Les applications installées d'office avec Windows (Candy Crush, Xbox, Cortana…). Supprimez celles dont vous n'avez pas besoin."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}" Margin="16,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="CountText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountLabel" Text="applications" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="SafeCountText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="sans risque" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recherche -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Rechercher une application ou un éditeur…"
                     TextChanged="SearchBox_TextChanged" />
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="12,9"
                    Click="Refresh_Click" ToolTip="Relire la liste des applications Windows">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Actualiser" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Explication -->
        <Border Grid.Row="2" Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{StaticResource LinkBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimary}"
                           Text="Rien n'est coché d'office. Les applications sont supprimées pour votre compte seulement, et vous pourrez les réinstaller à tout moment depuis le Microsoft Store. Les composants dont Windows a besoin ne sont pas affichés." />
            </Grid>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <ItemsControl x:Name="AppsList" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="10,9" Margin="0,1"
                                        services:Anim.EnterOnLoad="True">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ouvrir l'emplacement" Click="OpenLocation_Click" />
                                            <MenuItem Header="Copier le nom du paquet" Click="CopyName_Click" />
                                            <MenuItem Header="Voir dans le Microsoft Store" Click="OpenStore_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="Box" VerticalAlignment="Center" Margin="2,0,12,0"
                                                  IsEnabled="{Binding CanSelect}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0"
                                                Background="{StaticResource CardBackgroundRaised}">
                                            <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="15"
                                                       Foreground="{StaticResource LinkBrush}" HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="Note" Text="{Binding NoteText}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,1,0,0" />
                                            <TextBlock x:Name="LockedNote" Text="{Binding LockedText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,1,0,0" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PublisherText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SecondaryText}" FontSize="11.5" FontFamily="Consolas"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock x:Name="Result" Text="{Binding ResultText}" FontSize="12" Margin="0,3,0,0" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>

                                        <Border x:Name="Pill" Grid.Column="3" Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}"
                                                MinWidth="92" VerticalAlignment="Center" Margin="12,0,4,0">
                                            <TextBlock x:Name="PillText" Text="{Binding AdviceText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding HasNote}" Value="False">
                                        <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                        <Setter TargetName="LockedNote" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Advice}" Value="Know">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource LinkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Advice}" Value="Check">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Advice}" Value="Keep">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter TargetName="Result" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter TargetName="Result" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Lecture des applications Windows…" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="2" Width="220" Margin="0,10,0,0" />
                </StackPanel>
                <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="20" Visibility="Collapsed"
                           Text="Aucune application Windows supprimable n'a été trouvée pour votre compte." />
            </Grid>
        </Border>

        <!-- Barre d'action -->
        <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="FooterText" FontSize="14" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" Text="Aucune application cochée." />
                    <ProgressBar x:Name="RemoveProgress" Height="2" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectSafeButton" Content="Cocher les « Sans risque »" Style="{StaticResource GhostButton}"
                            Click="SelectSafe_Click" IsEnabled="False" />
                    <Button x:Name="SelectNoneButton" Content="Tout décocher" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                            Click="SelectNone_Click" IsEnabled="False" />
                    <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="Remove_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Désinstaller la sélection" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
