<UserControl x:Class="Desinstalleur.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Historique" Style="{StaticResource TitleText}" />
                <TextBlock Text="Vos nettoyages : date, éléments supprimés et espace réellement récupéré."
                           Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="CountText" Text="0" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="nettoyages" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="TotalText" Text="0 o" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="récupérés au total" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,14,14,8">
                    <TextBlock Text="DERNIERS NETTOYAGES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ClearButton" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="10,5"
                            Click="Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Effacer l'historique" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <ItemsControl x:Name="EntriesList" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,1"
                                        services:Anim.EnterOnLoad="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SuccessSoft}" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16"
                                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                           Margin="10,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ItemsText}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock x:Name="Errors" Text="{Binding ErrorsText}" Foreground="{StaticResource WarningBrush}"
                                                       FontSize="12" Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FreedText}" FontWeight="SemiBold" FontSize="15"
                                                   VerticalAlignment="Center" Margin="14,0,4,0" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter TargetName="Errors" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="Aucun nettoyage pour le moment." Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
