<UserControl x:Class="Desinstalleur.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nettoyage" Style="{StaticResource TitleText}" />
                <TextBlock Text="Videz les caches des jeux et des applications, et libérez de la mémoire."
                           Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="TotalCacheText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="récupérables" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Mémoire vive et réseau -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoft}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" FontSize="18" Foreground="#5AB4FF" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Mémoire vive (RAM)" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="RamText" Text="—" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                        </Grid>
                        <Grid Height="8" Margin="0,10,0,6">
                            <Border CornerRadius="4" Background="#1A2547" />
                            <Border x:Name="RamBar" CornerRadius="4" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="RamResultText" Text="Effet temporaire : Windows réutilise ensuite la mémoire libre selon ses besoins."
                                   Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RamButton" Grid.Column="2" Style="{StaticResource AccentButton}" Margin="18,0,0,0"
                            VerticalAlignment="Center" Click="FreeRam_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Libérer la RAM" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16" Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoft}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="18" Foreground="#5AB4FF" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cache DNS" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="DnsResultText" Text="Utile si un site ou un serveur ne répond plus."
                                   Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <Button Content="Vider le cache DNS" HorizontalAlignment="Left" Padding="14,7" Click="FlushDns_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Caches -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,14,14,8">
                    <TextBlock Text="CACHES ET FICHIERS INUTILES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Tout cocher" Style="{StaticResource GhostButton}" Padding="10,5" Click="SelectAll_Click" />
                        <Button Content="Tout décocher" Style="{StaticResource GhostButton}" Padding="10,5" Click="SelectNone_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" Click="Analyze_Click" ToolTip="Recalculer les tailles">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Analyser" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Profils de nettoyage -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,14,10">
                    <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="11" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Profil" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,10,0" />
                            <Rectangle Width="1" Height="20" Fill="#33416B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <RadioButton x:Name="ProfileCustom" GroupName="Profile" Style="{StaticResource SegmentButton}" Content="Personnalisé"
                                         Tag="Personnalisé" Checked="Profile_Checked" />
                            <RadioButton x:Name="ProfileGaming" GroupName="Profile" Style="{StaticResource SegmentButton}" Tag="Gaming"
                                         Checked="Profile_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Gaming" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ProfileBrowsers" GroupName="Profile" Style="{StaticResource SegmentButton}" Tag="Navigateurs"
                                         Checked="Profile_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Navigateurs" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Cochez ou décochez : le profil retient votre sélection." Style="{StaticResource SecondaryText}"
                               FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <ItemsControl x:Name="TargetsList" Margin="8,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,1"
                                        services:Anim.EnterOnLoad="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Margin="0,0,14,0"
                                                Background="{StaticResource CardBackgroundRaised}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16"
                                                       Foreground="#5AB4FF" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" Margin="10,1,0,0"
                                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Column="3" MinWidth="110" Margin="14,0,4,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Size" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <ProgressBar Width="80" IsIndeterminate="True" HorizontalAlignment="Right"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="Size" Property="Foreground" Value="{StaticResource TextDisabled}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter TargetName="Size" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Barre d'action -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource Card}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xEA99;" Style="{StaticResource IconText}" FontSize="15" Foreground="#5AB4FF" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Text="—" />
                <Button x:Name="CleanButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="Clean_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA99;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nettoyer la sélection" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
