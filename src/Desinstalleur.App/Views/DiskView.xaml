<UserControl x:Class="Desinstalleur.App.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <UserControl.Resources>
        <Style x:Key="DiskRowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Espace disque" Style="{StaticResource TitleText}" />
                <TextBlock Text="Trouvez ce qui prend le plus de place, puis ouvrez son emplacement. Rien n'est supprimé ici."
                           Style="{StaticResource SecondaryText}" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="FreeText" Text="—" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FreeLabel" Text="libres" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Choix de l'emplacement -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="DrivesList" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,0" Padding="14,8" Click="Drive_Click" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="ChooseFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Choisir un dossier…" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Résultats -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Style="{StaticResource GhostButton}" Padding="10,6" Click="Up_Click" IsEnabled="False"
                            ToolTip="Dossier parent">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" FontSize="14" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="PathText" Text="Choisissez un disque ou un dossier à analyser." FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="OpenCurrentButton" Style="{StaticResource GhostButton}" Padding="10,6" Click="OpenCurrent_Click"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Ouvrir" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Padding="10,6" Click="Cancel_Click"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Arrêter" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="ScanProgress" Grid.Row="0" VerticalAlignment="Bottom" IsIndeterminate="True" Height="2"
                             Margin="16,0" Visibility="Collapsed" />

                <!-- Comparaison avec l'analyse précédente -->
                <Grid x:Name="CompareBar" Grid.Row="1" Margin="16,2,14,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompareIcon" Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="14"
                                   Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="CompareText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="ViewSwitch" Grid.Column="1" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFoldersButton" GroupName="DiskViewMode" Style="{StaticResource SegmentButton}"
                                         Content="Tous les dossiers" IsChecked="True" Checked="ViewMode_Checked" />
                            <RadioButton x:Name="GrownButton" GroupName="DiskViewMode" Style="{StaticResource SegmentButton}"
                                         Content="Ce qui a grossi" Checked="ViewMode_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel x:Name="FirstScanHint" Grid.Row="1" Orientation="Horizontal" Margin="16,2,14,6" Visibility="Collapsed">
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                               Text="Première analyse de cet emplacement : la prochaine fois, vous verrez ce qui a grossi." />
                </StackPanel>

                <ListBox x:Name="RowsList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="8,4,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource DiskRowItem}" MouseDoubleClick="Rows_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid services:Anim.EnterOnLoad="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource CardBackgroundRaised}" Margin="0,0,12,0">
                                    <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15"
                                               Foreground="#5AB4FF" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" />
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource SecondaryText}" FontSize="11"
                                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                <Button x:Name="OpenButton" Grid.Column="4" Style="{StaticResource GhostButton}" Padding="8,6" Margin="10,0,0,0"
                                        Click="OpenLocation_Click" ToolTip="Ouvrir l'emplacement dans l'Explorateur">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsReal}" Value="False">
                                    <Setter TargetName="OpenButton" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextSecondary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="GrowthList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="8,4,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource DiskRowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid services:Anim.EnterOnLoad="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource CardBackgroundRaised}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="15"
                                               Foreground="#5AB4FF" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border x:Name="NewBadge" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}"
                                                Margin="8,0,0,0" Padding="7,1" Visibility="Collapsed">
                                            <TextBlock Text="Nouveau" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding BeforeAfterText}" Style="{StaticResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="3" Text="{Binding DeltaText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}" />
                                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="8,6" Margin="10,0,0,0"
                                        Click="OpenGrowthLocation_Click" ToolTip="Ouvrir l'emplacement dans l'Explorateur">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                    <Setter TargetName="NewBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="GrowthEmptyText" Grid.Row="2" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30" Visibility="Collapsed" />

                <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30"
                           Text="Choisissez un disque en haut pour voir ce qui occupe le plus de place.&#x0a;Double-cliquez sur un dossier pour voir son contenu." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
