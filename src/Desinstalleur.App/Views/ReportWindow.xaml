<Window x:Class="Desinstalleur.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstallix · Signaler un problème"
        Icon="/Assets/uninstallix.ico"
        Width="820" Height="700" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Signaler un problème" Style="{StaticResource TitleText}" FontSize="24" />
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="1,3,0,0"
                       Text="Décrivez ce qui s'est passé. Vérifiez l'aperçu : vous pouvez y effacer tout ce que vous ne voulez pas partager." />
        </StackPanel>

        <TextBox x:Name="DescriptionBox" Grid.Row="1" Style="{StaticResource Field}" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextChanged="Options_Changed" />

        <WrapPanel Grid.Row="2" Margin="0,12,0,10">
            <CheckBox x:Name="AnonymizeBox" Content="Masquer mes informations personnelles" IsChecked="True" Margin="0,0,22,6"
                      Click="Options_Changed" />
            <CheckBox x:Name="JournalBox" Content="Joindre le journal" IsChecked="True" Margin="0,0,22,6" Click="Options_Changed" />
            <CheckBox x:Name="SettingsBox" Content="Joindre les réglages" IsChecked="True" Margin="0,0,0,6" Click="Options_Changed" />
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="APERÇU DU RAPPORT (modifiable : faites vos retouches en dernier)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                       Margin="2,0,0,6" />
            <TextBox x:Name="PreviewBox" Grid.Row="1" Style="{StaticResource Field}" FontFamily="Consolas" FontSize="12"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,330,0"
                       Text="Ensuite, collez le rapport dans votre message à Claude." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fermer" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Close_Click" IsCancel="True" />
                <Button Margin="0,0,10,0" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Enregistrer" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Copier le rapport" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
