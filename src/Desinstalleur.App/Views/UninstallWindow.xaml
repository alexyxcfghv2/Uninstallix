<Window x:Class="Desinstalleur.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Desinstalleur.App.Services"
        Title="Uninstallix · Désinstallation"
        Icon="/Assets/uninstallix.ico"
        Width="980" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Grid Margin="30,24,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/logo-mark.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="Désinstallation" Style="{StaticResource TitleText}" FontSize="22" />
                <TextBlock x:Name="SubHeaderText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Suivez les instructions de chaque désinstalleur. Les logiciels sont traités l'un après l'autre." />
            </StackPanel>
        </Grid>

        <!-- Étape 1 : file de désinstallation -->
        <ScrollViewer x:Name="QueuePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QueueList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14"
                                services:Anim.EnterOnLoad="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.RowSpan="2" Width="42" Height="42" CornerRadius="11" Margin="0,0,16,0"
                                        Background="{StaticResource CardBackgroundRaised}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="InitialText" Text="{Binding Program.Initial}" FontWeight="SemiBold" FontSize="16"
                                                   Foreground="#5AB4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Program.Icon}" Width="28" Height="28"
                                               Visibility="{Binding Program.HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Program.DisplayName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border x:Name="StatusPill" Grid.Column="2" Style="{StaticResource Badge}" Margin="16,0,0,0"
                                        Background="{StaticResource CardBackgroundRaised}">
                                    <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Border>

                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsIndeterminate="True" Margin="0,10,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Program.HasIcon}" Value="True">
                                <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#5AB4FF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Removed">
                                <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource SuccessSoft}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="ForcedCleanup">
                                <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource WarningSoft}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="StillInstalled">
                                <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource WarningSoft}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource DangerSoft}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Étape 2 : restes à valider, une carte par logiciel -->
        <Grid x:Name="LeftoversPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="#5AB4FF" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimary}"
                               Text="Rien n'a encore été supprimé. Les éléments « Sûr » sont cochés, les éléments « À vérifier » ne le sont pas. Les fichiers iront dans la Corbeille et les clés de registre seront sauvegardées." />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LeftoverGroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="8,6,8,8"
                                    services:Anim.EnterOnLoad="True">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="12,10,12,8">
                                        <TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource CardBackgroundRaised}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="10,9" Margin="0,1"
                                                        services:Anim.EnterOnLoad="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox x:Name="Box" VerticalAlignment="Center" Margin="2,0,12,0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0"
                                                                Background="{StaticResource CardBackgroundRaised}" ToolTip="{Binding KindText}">
                                                            <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource IconText}" FontSize="15"
                                                                       Foreground="#5AB4FF" HorizontalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontSize="13" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                                <TextBlock x:Name="Result" Text="{Binding ResultText}" FontSize="12" Margin="10,0,0,0"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{StaticResource TextSecondary}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" Margin="0,0,14,0" />

                                                        <Border x:Name="Pill" Grid.Column="4" Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}"
                                                                MinWidth="78">
                                                            <TextBlock x:Name="PillText" Text="{Binding ConfidenceText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Confidence}" Value="Low">
                                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSoft}" />
                                                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                        <Setter TargetName="Box" Property="IsEnabled" Value="False" />
                                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Barre d'action -->
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Grid.Column="0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StopButton" Content="Arrêter après celui-ci" Click="Stop_Click" />
                    <Button x:Name="SelectAllButton" Content="Tout cocher" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Click="SelectAll_Click" Visibility="Collapsed" />
                    <Button x:Name="SelectNoneButton" Content="Tout décocher" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                            Click="SelectNone_Click" Visibility="Collapsed" />
                    <Button x:Name="KeepButton" Content="Ne rien supprimer" Margin="8,0,0,0" Click="Close_Click" Visibility="Collapsed" />
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="Delete_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Supprimer la sélection…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Content="Fermer" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                            Click="Close_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
