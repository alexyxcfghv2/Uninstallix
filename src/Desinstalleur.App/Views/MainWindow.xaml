<Window x:Class="Desinstalleur.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Desinstalleur.App.Views"
        Loaded="Window_Loaded"
        Title="Uninstallix"
        Icon="/Assets/uninstallix.ico"
        Width="1320" Height="820" MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Halo bleu discret derrière le contenu -->
        <Ellipse Grid.Column="1" Width="900" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-280,0,0"
                 IsHitTestVisible="False" Opacity="0.3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1E6BFF" Offset="0" />
                    <GradientStop Color="#001E6BFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Menu latéral -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="#0A1128" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,30">
                    <Image Source="/Assets/logo-mark.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Uninstallix" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDisabled}" Margin="12,0,0,8" />
                    <RadioButton x:Name="NavPrograms" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE71D;"
                                 Content="Logiciels" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCleanup" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xEA99;"
                                 Content="Nettoyage" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDisk" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xEDA2;"
                                 Content="Espace disque" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE81C;"
                                 Content="Historique" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="Réglages" Checked="Nav_Checked" />
                </StackPanel>

                <!-- Bandeau de mise à jour (caché tant qu'aucune nouvelle version n'est trouvée) -->
                <Button x:Name="UpdateBanner" Grid.Row="2" Style="{StaticResource AccentButton}" Margin="0,0,0,10" Padding="12,10"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed" Click="UpdateBanner_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="15" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Mise à jour disponible" FontSize="12" />
                            <TextBlock x:Name="UpdateBannerText" FontSize="11" FontWeight="Normal" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Mode administrateur" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="Version" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pages -->
        <!-- Les pages Nettoyage et Réglages ne sont créées qu'à leur première ouverture. -->
        <Grid x:Name="PagesHost" Grid.Column="1">
            <views:ProgramsView x:Name="ProgramsPage" />
        </Grid>
    </Grid>
</Window>
