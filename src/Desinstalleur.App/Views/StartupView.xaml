<UserControl x:Class="Desinstalleur.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Desinstalleur.App.Services"
             Foreground="{StaticResource TextPrimary}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Démarrage" Style="{StaticResource TitleText}" />
                <TextBlock Text="Les applications qui se lancent avec Windows. Désactivez celles dont vous n'avez pas besoin : rien n'est supprimé."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="1,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatChip}" Margin="16,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="EnabledCountText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="actives" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatChip}">
                <StackPanel>
                    <TextBlock x:Name="DisabledCountText" Text="0" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="désactivées" Style="{StaticResource SecondaryText}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Rechercher une application ou un éditeur…"
                     TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="12,9" Click="Refresh_Click"
                    ToolTip="Relire la liste des applications au démarrage">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Actualiser" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="APPLICATIONS AU DÉMARRAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                           Margin="20,14,14,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <ItemsControl x:Name="EntriesList" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,1"
                                        services:Anim.EnterOnLoad="True">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ouvrir l'emplacement" Click="OpenLocation_Click" />
                                            <MenuItem Header="Copier la commande" Click="CopyCommand_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="10" Background="{StaticResource CardBackgroundRaised}"
                                                Margin="0,0,14,0" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="&#xE7E8;" Style="{StaticResource IconText}" FontSize="16"
                                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,10,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Margin="0,0,6,0" Padding="7,1">
                                                    <TextBlock Text="{Binding ScopeText}" FontSize="11" />
                                                </Border>
                                                <Border x:Name="MissingBadge" Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}"
                                                        Padding="7,1" Visibility="Collapsed"
                                                        ToolTip="Le programme lancé n'existe plus. Vous pouvez désactiver cette entrée sans risque.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="11"
                                                                   Foreground="{StaticResource WarningBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="Fichier introuvable" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PublisherText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock Text="·" Style="{StaticResource SecondaryText}" FontSize="12" Margin="6,0" />
                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" Style="{StaticResource SecondaryText}"
                                                       FontSize="11.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,6" Margin="12,0,8,0"
                                                VerticalAlignment="Center" Click="OpenLocation_Click" ToolTip="Ouvrir l'emplacement">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" />
                                        </Button>
                                        <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Width="128"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding StateText}"
                                                  Click="Toggle_Click" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                        <Setter TargetName="MissingBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="Info" Property="Opacity" Value="0.6" />
                                        <Setter TargetName="IconBox" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="Aucune application ne se lance avec Windows." Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
