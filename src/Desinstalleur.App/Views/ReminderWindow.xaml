<Window x:Class="Desinstalleur.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rappel de nettoyage"
        Icon="/Assets/uninstallix.ico"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <!-- Marge autour de la carte pour laisser la place à l'ombre -->
    <Border x:Name="Panel" Margin="14" CornerRadius="14" Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,16,18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" VerticalAlignment="Top"
                        ToolTip="Fermer" Click="Later_Click">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </Button>
                <Border x:Name="Badge" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoft}"
                        DockPanel.Dock="Left" VerticalAlignment="Top">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="17" Foreground="#5AB4FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,1,8,0">
                    <TextBlock Text="Rappel de nettoyage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="MessageText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="Rien n'a été supprimé : vous voyez d'abord ce qui serait nettoyé."
                               Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="2,4" FontSize="12"
                        Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                        Content="Ne plus me rappeler" Click="Never_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Voir le nettoyage" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Plus tard"
                        Click="Later_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
