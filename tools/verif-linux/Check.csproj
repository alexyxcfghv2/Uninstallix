<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vérification sous Linux : compile le C# de l'appli WPF sans la compilation XAML (indisponible ici). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImportWindowsDesktopTargets>false</ImportWindowsDesktopTargets>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Desinstalleur.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <Compile Include="../../src/Desinstalleur.App/**/*.cs" Exclude="../../src/Desinstalleur.App/obj/**;../../src/Desinstalleur.App/bin/**" />
    <Compile Include="stubs/*.cs" />
    <!-- Comme un vrai projet WPF : System.IO n'est pas importé implicitement. -->
    <Using Remove="System.IO" />
    <Using Remove="System.Net.Http" />
    <ProjectReference Include="../../src/Desinstalleur.Core/Desinstalleur.Core.csproj" />
  </ItemGroup>
</Project>
